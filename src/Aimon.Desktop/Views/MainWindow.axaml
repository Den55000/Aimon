<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aimon.Desktop.ViewModels"
        xmlns:views="using:Aimon.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
        x:Class="Aimon.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="820" Height="560"
        Title="Aimon">

    <Design.DataContext>
        <!-- Previewer DataContext only; the runtime DataContext is set via DI in App.axaml.cs. -->
        <vm:ShellViewModel />
    </Design.DataContext>

    <TabControl Margin="6">
        <TabItem Header="Chat">
            <views:ChatView DataContext="{Binding Chat}" />
        </TabItem>
        <TabItem Header="Profile Compiler">
            <views:ProfileCompilerView DataContext="{Binding Compiler}" />
        </TabItem>
    </TabControl>

</Window>
