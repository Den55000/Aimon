<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aimon.Desktop.ViewModels"
        xmlns:views="using:Aimon.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="580"
        x:Class="Aimon.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="860" Height="580"
        Title="Aimon">

    <Design.DataContext>
        <!-- Previewer DataContext only; the runtime DataContext is set via DI in App.axaml.cs. -->
        <vm:ShellViewModel />
    </Design.DataContext>

    <DockPanel>

        <!-- Active-profile banner, themed with the profile's accent -->
        <Border DockPanel.Dock="Top" Background="{Binding AccentBrush}" Padding="12,7">
            <TextBlock Foreground="White" FontWeight="SemiBold"
                       Text="{Binding ActiveProfileName, StringFormat='Active profile: {0}'}" />
        </Border>

        <TabControl Margin="6">
            <TabItem Header="Chat">
                <views:ChatView DataContext="{Binding Chat}" />
            </TabItem>
            <TabItem Header="Profiles">
                <views:ProfileManagerView DataContext="{Binding Profiles}" />
            </TabItem>
            <TabItem Header="Profile Compiler">
                <views:ProfileCompilerView DataContext="{Binding Compiler}" />
            </TabItem>
        </TabControl>

    </DockPanel>

</Window>
