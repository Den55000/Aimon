<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aimon.Desktop.ViewModels"
             xmlns:views="using:Aimon.Desktop.Views"
             xmlns:agents="using:Aimon.Application.Agents"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="520"
             x:Class="Aimon.Desktop.Views.ChatView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Margin="12" ColumnDefinitions="170,*">

        <!-- Avatar: reacts to the AI's semantic state during a conversation -->
        <views:AvatarView Grid.Column="0" DataContext="{Binding Avatar}" Margin="0,0,12,0" />

        <!-- Chat -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto">

            <!-- Settings: backend picker, per-backend controls, and the live agent state -->
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">

                <!-- Backend + live state -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="Backend:" />
                    <ComboBox MinWidth="140" ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}"
                              ToolTip.Tip="Choose the model provider or a CLI agent (e.g. Claude Code).">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="agents:BackendDescriptor">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding StateLabel, StringFormat='State: {0}'}" />
                </StackPanel>

                <!-- Model provider controls -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsModelBackend}">
                    <TextBox Width="200" PlaceholderText="OpenAI API key" PasswordChar="•" Text="{Binding ApiKey}" />
                    <Button Content="Save key" Command="{Binding SaveKeyCommand}" />
                    <TextBox Width="120" PlaceholderText="Model" Text="{Binding Model}" />
                    <ComboBox Width="90" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                              ToolTip.Tip="Auto: the model decides. Chat: text only. Image: force image generation." />
                </StackPanel>

                <!-- CLI agent controls -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAgentBackend}">
                    <Button Content="Choose folder…" Command="{Binding PickWorkspaceCommand}" />
                    <TextBlock VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis"
                               Text="{Binding WorkspaceDisplay}" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{Binding BackendStatus}" />
                </StackPanel>

                <TextBlock IsVisible="{Binding IsAgentBackend}" Foreground="#C08040" FontSize="11"
                           Text="⚠ This agent can read and modify files in the chosen folder." />

            </StackPanel>

            <!-- Transcript: text and image bubbles -->
            <Border Grid.Row="1" BorderBrush="#40808080" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatMessageViewModel">
                                <Border Margin="0,4" Padding="8" CornerRadius="6" Background="#18808080">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                             IsVisible="{Binding HasText}" />
                                        <Image Source="{Binding Image}" MaxWidth="360" MaxHeight="360"
                                               HorizontalAlignment="Left" IsVisible="{Binding IsImage}" />
                                        <Button Content="Save image" HorizontalAlignment="Left"
                                                IsVisible="{Binding CanSave}"
                                                Command="{Binding SaveImageCommand}" CommandParameter="{Binding ImageData}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Pending image attachments (thumbnails) -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AttachmentViewModel">
                        <Border Margin="0,0,6,0" BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="2">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" Width="56" Height="56" Stretch="UniformToFill" />
                                <Button Content="✕" Padding="4,0" FontSize="10"
                                        VerticalAlignment="Top" HorizontalAlignment="Right"
                                        Command="{Binding RemoveCommand}" CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Input -->
            <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Margin="0,0,8,0" Content="Attach" Command="{Binding AttachImagesCommand}" />
                <TextBox Grid.Column="1" PlaceholderText="Type a message…" Text="{Binding Input}" />
                <Button Grid.Column="2" Margin="8,0,0,0" Content="Send"
                        Command="{Binding SendCommand}" IsDefault="True" />
            </Grid>

        </Grid>

    </Grid>

</UserControl>
