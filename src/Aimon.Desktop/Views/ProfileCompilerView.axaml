<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aimon.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="520"
             x:Class="Aimon.Desktop.Views.ProfileCompilerView"
             x:DataType="vm:ProfileCompilerViewModel">

    <Design.DataContext>
        <vm:ProfileCompilerViewModel />
    </Design.DataContext>

    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <!-- Profile name + Compile -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" PlaceholderText="Profile name" Text="{Binding Name}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="Compile" Command="{Binding CompileCommand}" />
        </Grid>

        <!-- Natural-language description -->
        <TextBox Grid.Row="1" Height="96" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8"
                 PlaceholderText="Describe the persona in plain language — who they are, their tone, do's and don'ts…"
                 Text="{Binding Description}" />

        <!-- Compiled draft preview -->
        <Border Grid.Row="2" BorderBrush="#40808080" BorderThickness="1" CornerRadius="6">
            <TextBox Text="{Binding DraftPreview}"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Consolas"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>

        <!-- Validation summary -->
        <TextBlock Grid.Row="3" Margin="2,8,0,0" TextWrapping="Wrap" Text="{Binding ValidationSummary}" />

        <!-- Revision instruction + Revise -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBox Grid.Column="0" PlaceholderText="How should the draft change? (then Revise)"
                     Text="{Binding RevisionInstruction}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="Revise" Command="{Binding ReviseCommand}" />
        </Grid>

        <!-- Confirm + status -->
        <Grid Grid.Row="5" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
            <Button Grid.Column="0" Content="Confirm and save" Command="{Binding ConfirmCommand}" />
            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{Binding StatusLabel}" />
        </Grid>

    </Grid>

</UserControl>
